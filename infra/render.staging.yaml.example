# Aplicar deliberadamente após resolver #5 e #17.
services:
  - type: web
    name: golift-staging
    runtime: node
    plan: free
    region: frankfurt
    branch: develop
    rootDir: backend
    autoDeployTrigger: 'off'
    buildCommand: test "$(node --version)" = "v22.23.4" && test "$(npm --version)" = "10.9.9" && npm ci
    startCommand: npm start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_VERSION
        value: '22.23.4'
      - key: NODE_ENV
        value: production
      - key: APP_ENV
        value: staging
      - key: NOTIFICATION_SCHEDULER_ENABLED
        value: 'false'
      - key: SUPABASE_URL
        sync: false
      - key: STAGING_SUPABASE_URL
        sync: false
      - key: PRODUCTION_SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_KEY
        sync: false
      - key: SERVER_URL
        sync: false
      - key: CLIENT_URL
        sync: false
